# URL canonique du site (sans barre finale). À confirmer avec le client (nom de domaine).
NEXT_PUBLIC_SITE_URL=https://www.osteopathe-merhi-creil.fr

# Mode relecture client : affiche les badges « À confirmer / À fournir ».
# Mettre à "false" en production, une fois toutes les données validées (npm run check:content).
NEXT_PUBLIC_REVIEW_MODE=true

# Indexation hors Vercel : "true" uniquement sur l'environnement de production.
# Sur Vercel, VERCEL_ENV=production suffit (robots.txt autorise alors l'indexation).
ALLOW_INDEXING=false

# Tests end-to-end : navigateur système facultatif (sinon : npx playwright install chromium)
# PLAYWRIGHT_CHROME_PATH=/usr/bin/google-chrome
